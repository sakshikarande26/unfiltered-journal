{
  "name": "the-unfiltered-journal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "server"
  ],
  "scripts": {
    "dev": "tsx watch backend/index.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
